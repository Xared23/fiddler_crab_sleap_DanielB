.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

remap_v004_logs/
*.mp4
.DS_Store

# Generated artifacts; keep source code, configs and docs reviewable.
logs/
checks/**/training_smoke/
checks/**/unit_tmp/
models/**/*.ckpt

# SLEAP labels/predictions and dataframe payloads, wherever generated.
*.slp
*.parquet

# Local dataset artifacts (not the documentation under docs/datasets/). The
# legacy water-region config is pinned by configs/prediction/*.json, so keep it.
/datasets/*
!/datasets/legacy_native_tracklets_v001/
/datasets/legacy_native_tracklets_v001/*
!/datasets/legacy_native_tracklets_v001/config/

# Local legacy payloads and incomplete demo builds must not be committed.
/archive/
/demo/.build_*/

# Narrow exception: the bounded, self-contained collaborator demo.
!/demo/crab_cam2_2_middle_300/Crab_Cam_2_2.frames_014250_014549.mp4
!/demo/crab_cam2_2_middle_300/Crab_Cam_2_2.frames_014250_014549.predictions.slp
!/demo/crab_cam2_2_middle_300/Crab_Cam_2_2.frames_014250_014549.tracked.slp
!/demo/crab_cam2_2_middle_300/observations.parquet
!/demo/crab_cam2_2_middle_300/frames.parquet
# The 2,000-frame demo (frames 13410-15409, lossless chunks; copied from my-code).
!/demo/crab_cam2_2_middle_2000/chunk_*/Crab_Cam_2_2.frames_*.mp4
!/demo/crab_cam2_2_middle_2000/chunk_*/Crab_Cam_2_2.frames_*.predictions.slp
!/demo/crab_cam2_2_middle_2000/chunk_*/Crab_Cam_2_2.frames_*.tracked.slp
!/demo/crab_cam2_2_middle_2000/chunk_*/observations.parquet
!/demo/crab_cam2_2_middle_2000/chunk_*/frames.parquet
!/demo/crab_cam2_2_middle_2000/observations.parquet
!/demo/crab_cam2_2_middle_2000/frames.parquet

